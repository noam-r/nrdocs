{
  "name": "nrdocs",
  "version": "2.0.0",
  "description": "Publish a Markdown directory as a protected Cloudflare minisite",
  "type": "module",
  "bin": {
    "nrdocs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@nrdocs/contracts": "workspace:*",
    "@nrdocs/persistence": "workspace:*",
    "@nrdocs/renderer": "workspace:*",
    "yaml": "2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
