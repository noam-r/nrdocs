{
  "name": "nrdocs",
  "version": "2.0.0",
  "description": "Publish a Markdown directory as a protected Cloudflare minisite",
  "type": "module",
  "bin": {
    "nrdocs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "packaged",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle:release": "node scripts/bundle-release.mjs",
    "build": "pnpm run bundle:release",
    "pack:check": "node scripts/pack-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@nrdocs/contracts": "workspace:*",
    "@nrdocs/persistence": "workspace:*",
    "@nrdocs/renderer": "workspace:*",
    "highlight.js": "11.11.1",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "unist-util-visit": "5.0.0",
    "yaml": "2.8.0"
  },
  "devDependencies": {
    "@nrdocs/worker": "workspace:*",
    "@types/node": "^24.13.3",
    "mermaid": "11.16.0"
  }
}
